APP_NAME="AI Agent Verification System"
APP_ENV=development
DEBUG=false

API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Use a locally stored secret. Never commit a database password or connection URL.
DATABASE_URL=postgresql+psycopg://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require

# Didit stays disabled until a sandbox API key, workflow, signed webhook, and
# allowed return URL are configured. Never add populated values to source
# control or NEXT_PUBLIC_ variables.
DIDIT_ENABLED=false
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
# Optional: accepts the prior signing secret during the 24-hour rotation window.
DIDIT_WEBHOOK_PREVIOUS_SECRET=
DIDIT_RETURN_URL=http://localhost:3000/dashboard/verification
DIDIT_ENVIRONMENT=sandbox
